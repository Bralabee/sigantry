table Orders

    column 'OrderId'
        dataType: int64
        sourceColumn: OrderId

    column 'Amount'
        dataType: decimal
        sourceColumn: Amount
        summarizeBy: sum

    measure 'Total Sales' = SUM('Orders'[Amount])
        formatString: $ #,##0

    partition 'Orders' = m
        mode: import
        source =
            let
                Source = #table({"OrderId", "Amount"}, {{1, 100.0}, {2, 250.0}})
            in
                Source
